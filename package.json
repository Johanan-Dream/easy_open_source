{
  "name": "easygit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "collect": "node scripts/collect.ts",
    "check:links": "node scripts/check-links.ts",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/browser-audit.mjs",
    "check": "node --run test"
  },
  "engines": {
    "node": ">=22.18"
  }
}
